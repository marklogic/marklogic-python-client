# Copy to .env (git-ignored) and fill in. Use your personal scoped Harness token with read-only access.
HARNESS_USEREMAIL=
HARNESS_TOKEN=

# Credentials for the Poetry source named "harness"; VS Code terminals load this file, so poetry works there directly.
POETRY_HTTP_BASIC_HARNESS_USERNAME=${HARNESS_USEREMAIL}
POETRY_HTTP_BASIC_HARNESS_PASSWORD=${HARNESS_TOKEN}
